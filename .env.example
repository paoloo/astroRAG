# Ollama daemon used for both embeddings and generation.
# On atadev this is already running system-wide, so localhost is correct
# once this pipeline runs on that box (see Makefile deploy/run-remote targets).
OLLAMA_HOST=http://localhost:11434

# Model names (pulled via `ollama pull <name>` on whichever host runs OLLAMA_HOST)
EMBEDDING_MODEL=nomic-embed-text
GENERATION_MODEL=qwen2.5:14b-instruct

# Where pipeline artifacts live. Defaults to ./data relative to the repo root.
# On atadev this is set to a writable directory on the 15TB /mnt/raid1 array
# (paolo has no write access to /home/paolo beyond a few GB - see PLAN.md):
# VECTOR_DATA_DIR=/mnt/raid1/paolo_tests/vector-rag/data
